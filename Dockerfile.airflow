# Airflow image: official base + project dependencies + DAG code.
# DAGs invoke `python -m credit_decision.*`, so the whole project is on
# PYTHONPATH and all DB/MLflow env vars are inherited from compose.
#
# Note: the official image wraps `pip` to refuse root installs; `python -m pip`
# is the real package manager and is the documented escape hatch for builds.
FROM apache/airflow:2.10.5-python3.11

USER root
COPY requirements.txt /requirements.txt
RUN python -m pip install --no-cache-dir -r /requirements.txt && \
    python -m pip install --no-cache-dir "sqlalchemy<2.0"  # airflow 2.10 pins sqlalchemy<2.0

COPY . /app
ENV PYTHONPATH=/app
USER airflow
