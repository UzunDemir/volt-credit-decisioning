# Copy to .env and adjust. docker-compose reads these automatically.

# PostgreSQL
POSTGRES_USER=volt
POSTGRES_PASSWORD=volt
POSTGRES_DB=volt_credit
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlartifacts

# API
API_HOST=0.0.0.0
API_PORT=8000

# Data generation (seeded, deterministic)
DATA_SEED=42
DATA_N_APPLICATIONS=150000
DATA_N_TXNS_PER_CLIENT_MIN=3
DATA_N_TXNS_PER_CLIENT_MAX=220

# Model
MODEL_APPROVAL_THRESHOLD=0.35
# pydantic-settings does not support inline comments - keep values clean
MODEL_COST_FP=1.0
# cost of false positive (approved but defaulted) / false negative (declined good client)
MODEL_COST_FN=0.2
