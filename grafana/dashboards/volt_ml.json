    {
      "id": 1,
      "type": "stat",
      "title": "Drift share (latest batch)",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "voltdb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "voltdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (metrics->>'share_drifted')::float AS value FROM monitoring_events WHERE report_type = 'data_drift' ORDER BY event_id DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.15
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
